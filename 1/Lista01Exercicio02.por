programa
{
	funcao inicio()
	{
		

		real vBaseMaior, vBaseMenor, vAltura, vResultado

		leia(vBaseMaior)
		leia(vBaseMenor)
		leia(vAltura)

		// respondendo item 1
		vResultado = (((vBaseMaior + vBaseMenor) *  vAltura) / 2)
		escreva(vResultado)

	}
}
